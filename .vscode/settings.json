{
    "terminal.integrated.profiles.windows": {
    "PowerShell with UTF-8": {
        "path": "powershell.exe",
        "args": [
            "-NoExit",
            "-Command",
            "$OutputEncoding = [System.Console]::OutputEncoding = [System.Text.Encoding]::UTF8"
        ]
    }
},
"terminal.integrated.defaultProfile.windows": "PowerShell with UTF-8"
}